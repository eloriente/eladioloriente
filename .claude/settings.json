{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Edit(/src/**)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npm pkg:*)",
      "Bash(npx astro add:*)",
      "Bash(rm -rf:*)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/node_modules/**)",
      "Edit(/public/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/restrict-edits.mjs\""
          }
        ]
      }
    ]
  }
}
