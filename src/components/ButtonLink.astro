---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary';
}

const { variant = 'primary', class: className, ...attrs } = Astro.props;
---

<a
  {...attrs}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition-colors',
    variant === 'primary'
      ? 'bg-brand-600 text-white shadow-sm hover:bg-brand-700'
      : 'border border-zinc-300 text-zinc-900 hover:border-brand-400 hover:text-brand-700 dark:border-zinc-700 dark:text-white dark:hover:border-brand-500 dark:hover:text-brand-300',
    className,
  ]}
>
  <slot />
</a>
