---
import { languages, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternates: { lang: Lang; href: string }[];
  class?: string;
}

const { lang, alternates, class: className } = Astro.props;
const t = useTranslations(lang);
---

<ul aria-label={t('lang.label')} class:list={['flex rounded-full border border-zinc-200 p-0.5 text-xs font-semibold dark:border-zinc-800', className]}>
  {
    alternates.map((alt) => (
      <li>
        <a
          href={alt.href}
          hreflang={alt.lang}
          lang={alt.lang}
          title={languages[alt.lang]}
          aria-current={alt.lang === lang ? 'true' : undefined}
          class:list={[
            'block rounded-full px-2.5 py-1 uppercase transition-colors',
            alt.lang === lang
              ? 'bg-brand-600 text-white'
              : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white',
          ]}
        >
          <span class="sr-only">{languages[alt.lang]}</span>
          <span aria-hidden="true">{alt.lang}</span>
        </a>
      </li>
    ))
  }
</ul>
