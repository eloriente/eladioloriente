---
import BaseLayout from '@shared/layout/BaseLayout.astro';
import PageHeader from '@shared/components/PageHeader.astro';
import Section from '@shared/components/Section.astro';
import type { Lang } from '@shared/i18n/languages';
import PostCard from './components/PostCard.astro';
import { useBlogTranslations } from './i18n';
import { getPosts } from './queries';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useBlogTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={t('title')} description={t('intro')} path="/blog/">
  <PageHeader title={t('title')} intro={t('intro')} />
  <Section>
    {
      posts.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <li>
              <PostCard post={post} lang={lang} />
            </li>
          ))}
        </ul>
      ) : (
        <p>{t('empty')}</p>
      )
    }
  </Section>
</BaseLayout>
