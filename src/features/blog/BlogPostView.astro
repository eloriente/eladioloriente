---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@shared/layout/BaseLayout.astro';
import PageHeader from '@shared/components/PageHeader.astro';
import Section from '@shared/components/Section.astro';
import Tag from '@shared/components/Tag.astro';
import TagList from '@shared/components/TagList.astro';
import { translatedLangs } from '@shared/content/entries';
import { profile } from '@shared/data/profile';
import { intlLocale, localizePath, type Lang } from '@shared/i18n/languages';
import { useTranslations } from '@shared/i18n/ui';
import { formatDate } from '@shared/lib/format';
import { absoluteUrl, blogPostingSchema, breadcrumbSchema } from '@shared/lib/seo';
import { useBlogTranslations } from './i18n';
import type { Post } from './queries';

interface Props {
  post: Post;
  lang: Lang;
  translations: Record<Lang, string>;
}

const { post, lang, translations } = Astro.props;
const { title, description, date, type, event, tags } = post.data;
const t = useBlogTranslations(lang);
const locale = intlLocale[lang];
const { Content } = await render(post);

// Datos estructurados: artículo y migas de pan.
const site = Astro.site ?? new URL(profile.url);
const url = absoluteUrl(localizePath(lang, translations[lang]), site);
const photo = await getImage({ src: profile.photo, width: 800, format: 'jpg' });
const jsonLd = [
  blogPostingSchema({
    headline: title,
    description,
    url,
    datePublished: date,
    inLanguage: locale,
    authorName: profile.name,
    authorUrl: absoluteUrl(localizePath(lang, '/'), site),
    image: absoluteUrl(photo.src, site),
    keywords: tags,
  }),
  breadcrumbSchema([
    { name: useTranslations(lang)('nav.home'), url: absoluteUrl(localizePath(lang, '/'), site) },
    { name: t('title'), url: absoluteUrl(localizePath(lang, '/blog/'), site) },
    { name: title, url },
  ]),
];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={translations[lang]}
  translations={translations}
  alternateLangs={translatedLangs(translations, 'blog')}
  type="article"
  publishedTime={date}
  tags={tags}
  jsonLd={jsonLd}
>
  <PageHeader title={title} intro={description}>
    <a
      slot="before"
      href={localizePath(lang, '/blog/')}
      class="mb-6 inline-flex gap-1.5 text-sm font-medium text-brand-700 hover:text-brand-900 dark:text-brand-300"
    >
      <span aria-hidden="true">←</span>
      {t('back')}
    </a>
    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-zinc-500 dark:text-zinc-400">
      <Tag variant={type === 'event' ? 'brand' : 'neutral'}>{t(`type.${type}`)}</Tag>
      <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
    </div>
  </PageHeader>

  <Section class="max-w-3xl!">
    {
      event && (
        <dl class="mb-10 grid gap-4 rounded-2xl border border-brand-200 bg-brand-50 p-5 sm:grid-cols-3 dark:border-brand-900 dark:bg-brand-950/40">
          <div>
            <dt class="text-sm text-zinc-500 dark:text-zinc-400">{t('event.when')}</dt>
            <dd class="font-semibold text-zinc-900 dark:text-white">
              <time datetime={event.date.toISOString()}>{formatDate(event.date, locale)}</time>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-zinc-500 dark:text-zinc-400">{t('event.where')}</dt>
            <dd class="font-semibold text-zinc-900 dark:text-white">{event.location}</dd>
          </div>
          {event.url && (
            <div class="self-center">
              <a href={event.url} target="_blank" rel="noopener" class="font-medium text-brand-700 underline dark:text-brand-300">
                {t('event.link')}
              </a>
            </div>
          )}
        </dl>
      )
    }
    <div class="prose-content">
      <Content />
    </div>
    {tags.length > 0 && <div class="mt-10"><TagList items={tags} /></div>}
  </Section>
</BaseLayout>
