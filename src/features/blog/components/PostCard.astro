---
import Tag from '@shared/components/Tag.astro';
import { splitId } from '@shared/content/entries';
import { intlLocale, localizePath, type Lang } from '@shared/i18n/languages';
import { formatDate } from '@shared/lib/format';
import { useBlogTranslations } from '../i18n';
import type { Post } from '../queries';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { title, description, date, type, event } = post.data;
const t = useBlogTranslations(lang);
const href = localizePath(lang, `/blog/${splitId(post.id).slug}/`);
const shownDate = event?.date ?? date;
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-zinc-200 p-6 transition-colors hover:border-brand-300 dark:border-zinc-800 dark:hover:border-brand-700"
>
  <div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
    <Tag variant={type === 'event' ? 'brand' : 'neutral'}>{t(`type.${type}`)}</Tag>
    <time datetime={shownDate.toISOString()}>{formatDate(shownDate, intlLocale[lang])}</time>
    {event && <span>· {event.location}</span>}
  </div>
  <h3 class="mt-3 text-lg font-semibold text-zinc-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="mt-2 text-pretty">{description}</p>
</article>
