---
import TagList from '@shared/components/TagList.astro';
import { intlLocale, type Lang } from '@shared/i18n/languages';
import { formatDuration, formatMonth, monthsBetween } from '@shared/lib/format';
import { useExperienceTranslations } from '../i18n';
import type { ExperienceEntry } from '../queries';

interface Props {
  item: ExperienceEntry;
  lang: Lang;
  /** Versión resumida, sin logros ni tecnologías. */
  compact?: boolean;
}

const { item, lang, compact = false } = Astro.props;
const { company, client, role, start, end, summary, highlights, stack, links } = item.data;
const t = useExperienceTranslations(lang);
const locale = intlLocale[lang];
const period = `${formatMonth(start, locale)} – ${end ? formatMonth(end, locale) : t('present')}`;
const duration = formatDuration(monthsBetween(start, end), locale);
---

<article class="relative pl-8">
  <span
    aria-hidden="true"
    class:list={[
      'absolute top-1.5 left-0 size-3.5 rounded-full border-2',
      end ? 'border-brand-300 bg-white dark:border-brand-700 dark:bg-zinc-950' : 'border-brand-600 bg-brand-600',
    ]}
  ></span>
  <p class="text-sm text-zinc-500 dark:text-zinc-400">
    <time datetime={start}>{period}</time>
    <span aria-hidden="true"> · </span>{duration}
  </p>
  <h3 class="mt-1 text-lg font-semibold text-zinc-900 dark:text-white">{role[lang]}</h3>
  <p class="font-medium text-brand-700 dark:text-brand-300">
    {company}{client && <span class="text-zinc-500 dark:text-zinc-400"> · {client}</span>}
  </p>
  <p class:list={['mt-3 text-pretty', compact && 'line-clamp-3']}>{summary[lang]}</p>
  {
    !compact && highlights && (
      <ul class="mt-3 list-disc space-y-1 pl-5 marker:text-brand-500">
        {highlights[lang].map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
  {
    !compact && links.length > 0 && (
      <div class="mt-4">
        <p class="text-sm font-medium text-zinc-900 dark:text-white">{t('links')}</p>
        <ul class="mt-1.5 space-y-1.5 text-sm">
          {links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-baseline gap-1.5 font-medium text-brand-700 underline decoration-brand-300 underline-offset-4 hover:decoration-brand-600 dark:text-brand-300 dark:decoration-brand-700"
              >
                {link.label[lang]}
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 shrink-0 self-center">
                  <path d="M11 3a1 1 0 100 2h2.59l-6.3 6.3a1 1 0 101.42 1.4L15 6.42V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                </svg>
                <span class="sr-only">{t('external')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {!compact && <div class="mt-4"><TagList items={stack} /></div>}
</article>
