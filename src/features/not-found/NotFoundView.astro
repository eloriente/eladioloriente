---
import BaseLayout from '@shared/layout/BaseLayout.astro';
import ButtonLink from '@shared/components/ButtonLink.astro';
import { defaultLang, langs, localizePath } from '@shared/i18n/languages';
import { useNotFoundTranslations } from './i18n';

const lang = defaultLang;
const t = useNotFoundTranslations(lang);
const others = langs.filter((l) => l !== lang);
---

<BaseLayout lang={lang} title={t('title')} path="/">
  <div class="mx-auto max-w-5xl px-4 py-24 text-center sm:px-6">
    <p class="text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">{t('title')}</h1>
    <p class="mt-3">{t('text')}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <ButtonLink href={localizePath(lang, '/')}>{t('back')}</ButtonLink>
      {
        others.map((l) => (
          <ButtonLink href={localizePath(l, '/')} variant="secondary" lang={l}>
            {useNotFoundTranslations(l)('back')}
          </ButtonLink>
        ))
      }
    </div>
  </div>
</BaseLayout>
