---
import Tag from '@shared/components/Tag.astro';
import TagList from '@shared/components/TagList.astro';
import { splitId } from '@shared/content/entries';
import { localizePath, type Lang } from '@shared/i18n/languages';
import { useProjectsTranslations } from '../i18n';
import type { Project } from '../queries';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { title, description, status, stack } = project.data;
const t = useProjectsTranslations(lang);
const href = localizePath(lang, `/projects/${splitId(project.id).slug}/`);
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-zinc-200 bg-white p-6 transition-colors hover:border-brand-300 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-brand-700"
>
  <div>
    <Tag variant={status === 'active' ? 'brand' : 'neutral'}>{t(`status.${status}`)}</Tag>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-zinc-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-300">
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class="mt-2 flex-1 text-pretty">{description}</p>
  <div class="mt-4"><TagList items={stack} /></div>
</article>
