---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import { defaultLang, langs } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
const other = langs.filter((l) => l !== lang);
---

<BaseLayout lang={lang} title={t('notFound.title')} path="/">
  <div class="mx-auto max-w-5xl px-4 py-24 text-center sm:px-6">
    <p class="text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">{t('notFound.title')}</h1>
    <p class="mt-3">{t('notFound.text')}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <ButtonLink href={localizePath(lang, '/')}>{t('notFound.back')}</ButtonLink>
      {
        other.map((l) => (
          <ButtonLink href={localizePath(l, '/')} variant="secondary" lang={l}>
            {useTranslations(l)('notFound.back')}
          </ButtonLink>
        ))
      }
    </div>
  </div>
</BaseLayout>
