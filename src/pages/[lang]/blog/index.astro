---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import Section from '../../../components/Section.astro';
import type { Lang } from '../../../i18n/ui';
import { langStaticPaths, useTranslations } from '../../../i18n/utils';
import { getPosts } from '../../../utils/collections';

export const getStaticPaths = langStaticPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={t('blog.title')} description={t('blog.intro')} path="/blog/">
  <PageHeader title={t('blog.title')} intro={t('blog.intro')} />
  <Section>
    {
      posts.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <li>
              <PostCard post={post} lang={lang} />
            </li>
          ))}
        </ul>
      ) : (
        <p>{t('blog.empty')}</p>
      )
    }
  </Section>
</BaseLayout>
