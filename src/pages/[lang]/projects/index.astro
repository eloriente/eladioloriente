---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Section from '../../../components/Section.astro';
import type { Lang } from '../../../i18n/ui';
import { langStaticPaths, useTranslations } from '../../../i18n/utils';
import { getProjects } from '../../../utils/collections';

export const getStaticPaths = langStaticPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.intro')} path="/projects/">
  <PageHeader title={t('projects.title')} intro={t('projects.intro')} />
  <Section>
    {
      projects.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} lang={lang} />
            </li>
          ))}
        </ul>
      ) : (
        <p>{t('projects.empty')}</p>
      )
    }
  </Section>
</BaseLayout>
