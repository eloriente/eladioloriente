---
interface Props {
  id?: string;
  title?: string;
  /** Enlace "ver todo" junto al título. */
  link?: { href: string; label: string };
  class?: string;
}

const { id, title, link, class: className } = Astro.props;
---

<section id={id} class:list={['mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20', className]}>
  {
    (title || link) && (
      <div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        {title && <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 sm:text-3xl dark:text-white">{title}</h2>}
        {link && (
          <a
            href={link.href}
            class="text-sm font-medium text-brand-700 hover:text-brand-900 dark:text-brand-300 dark:hover:text-brand-200"
          >
            {link.label} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    )
  }
  <slot />
</section>
