---
import Tag from './Tag.astro';

interface Props {
  items: string[];
  label?: string;
}

const { items, label } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label={label}>
      {items.map((item) => (
        <li>
          <Tag>{item}</Tag>
        </li>
      ))}
    </ul>
  )
}
