---
import { Image } from 'astro:assets';
import LanguagePicker from './LanguagePicker.astro';
import { profile } from '../data/profile';
import { localizePath, type Lang } from '../i18n/languages';
import { useTranslations, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: { lang: Lang; href: string }[];
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname;

const nav: { key: UiKey; path: string }[] = [
  { key: 'nav.experience', path: '/experience/' },
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.blog', path: '/blog/' },
  { key: 'nav.contact', path: '/#contact' },
];
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/85 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/85"
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-3 sm:flex-nowrap sm:px-6">
    <a
      href={localizePath(lang, '/')}
      class="flex items-center gap-2 font-semibold tracking-tight text-zinc-900 dark:text-white"
    >
      <Image
        src={profile.photo}
        alt=""
        widths={[32, 64]}
        sizes="32px"
        class="size-8 rounded-full object-cover ring-2 ring-brand-200 dark:ring-brand-800"
      />
      {profile.name}
    </a>

    <LanguagePicker lang={lang} alternates={alternates} class="ml-auto sm:order-last" />

    <nav aria-label={t('nav.label')} class="-mx-2 w-full overflow-x-auto sm:mx-0 sm:ml-auto sm:w-auto">
      <ul class="flex gap-1 text-sm font-medium">
        {
          nav.map(({ key, path }) => {
            const href = localizePath(lang, path);
            const active = !path.includes('#') && current.startsWith(href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-2 py-1.5 whitespace-nowrap transition-colors',
                    active
                      ? 'text-brand-700 dark:text-brand-300'
                      : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white',
                  ]}
                >
                  {t(key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
